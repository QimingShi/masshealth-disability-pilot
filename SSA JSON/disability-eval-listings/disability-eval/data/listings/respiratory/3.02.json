{
  "code": "3.02",
  "title": "Chronic respiratory disorders",
  "body_system": "respiratory",
  "version": 1,
  "summary": "Chronic respiratory disorder (COPD, emphysema, pulmonary fibrosis, pneumoconiosis, bronchiectasis) meeting one of: low FEV1, low FVC, low DLCO, low ABG/SpO2, or three exacerbations within 12 months requiring hospitalization.",
  "synonyms": {
    "COPD":                    ["chronic obstructive pulmonary disease", "chronic bronchitis", "emphysema", "obstructive lung disease"],
    "pulmonary fibrosis":      ["IPF", "idiopathic pulmonary fibrosis", "lung fibrosis", "interstitial lung disease", "ILD"],
    "pneumoconiosis":          ["black lung", "asbestosis", "silicosis", "coal workers pneumoconiosis"],
    "bronchiectasis":          ["dilated airways", "chronic bronchiectasis"],
    "FEV1":                    ["forced expiratory volume", "FEV-1", "FEV1.0", "1-second forced expiratory volume"],
    "FVC":                     ["forced vital capacity", "vital capacity"],
    "DLCO":                    ["diffusing capacity", "diffusion capacity", "DLCO/VA"],
    "spirometry":              ["pulmonary function test", "PFT", "lung function test", "PFTs"],
    "ABG":                     ["arterial blood gas", "blood gas", "PaO2", "PaCO2"],
    "SpO2":                    ["oxygen saturation", "pulse oximetry", "O2 sat", "saturation"],
    "shortness of breath":     ["SOB", "DOE", "dyspnea on exertion", "dyspnea", "breathlessness"],
    "hospitalization":         ["hospital admission", "inpatient stay", "hospitalized"],
    "exacerbation":            ["acute exacerbation", "AECOPD", "flare", "decompensation"],
    "12 months":               ["1 year", "one year", "longstanding", "chronic"]
  },
  "rule_json": {
    "logic": "OR",
    "path": "ROOT",
    "children": [
      {
        "path": "A",
        "criterion": "FEV1 less than or equal to the value in SSA Table I-A or I-B for age, sex, and height (without shoes), measured during stable period",
        "keywords": ["FEV1", "spirometry", "PFT", "post-bronchodilator", "Table I", "low FEV1", "L"]
      },
      {
        "path": "B",
        "criterion": "FVC less than or equal to the value in SSA Table II-A or II-B for age, sex, and height (without shoes)",
        "keywords": ["FVC", "forced vital capacity", "spirometry", "Table II", "restrictive pattern"]
      },
      {
        "path": "C",
        "criterion": "Chronic impairment of gas exchange demonstrated by DLCO ≤ Table III value, or arterial PaO2/PaCO2 ≤ Table IV-A/B/C, or SpO2 ≤ Table V on pulse oximetry",
        "keywords": ["DLCO", "diffusing capacity", "PaO2", "PaCO2", "ABG", "SpO2", "pulse oximetry", "gas exchange", "Table III", "Table IV", "Table V"]
      },
      {
        "logic": "AND",
        "path": "D",
        "criterion": "Three exacerbations or complications within 12-month period, each lasting ≥48 hours and requiring hospitalization, with at least 30 days between each",
        "children": [
          {
            "path": "D.1",
            "criterion": "Three separate hospitalizations for respiratory exacerbations or complications within a consecutive 12-month period",
            "keywords": ["three hospitalizations", "exacerbation", "AECOPD", "hospital admission", "respiratory failure", "acute decompensation"],
            "duration_months_required": 12
          },
          {
            "path": "D.2",
            "criterion": "Each hospitalization lasted at least 48 hours, with at least 30 days between consecutive hospitalizations",
            "keywords": ["48 hours", "30 days apart", "inpatient stay", "length of stay"]
          }
        ]
      }
    ]
  }
}
