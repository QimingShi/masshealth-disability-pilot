{
  "code": "11.18",
  "title": "Traumatic brain injury",
  "body_system": "neurological",
  "version": 2,
  "summary": "Traumatic brain injury with one of (persisting for at least 3 consecutive months after the injury): A) disorganization of motor function in two extremities, or B) marked limitation in physical functioning AND in one of four mental functioning areas. The 3-month duration is POST-INJURY persistence, NOT treatment adherence.",
  "synonyms": {
    "TBI": [
      "traumatic brain injury",
      "head injury",
      "concussion",
      "post-concussive syndrome",
      "PCS",
      "closed head injury",
      "open head injury"
    ],
    "MRI brain": [
      "brain MRI",
      "MRI of brain"
    ],
    "CT head": [
      "head CT",
      "non-contrast CT",
      "CT scan of head"
    ],
    "Glasgow Coma Scale": [
      "GCS",
      "GCS score"
    ],
    "neuropsych": [
      "neuropsychological testing",
      "neuropsych eval",
      "cognitive testing"
    ],
    "3 months": [
      "three months",
      "12 weeks",
      "post-injury"
    ]
  },
  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "path": "PRECONDITION",
        "criterion": "Traumatic brain injury diagnosis (clinical history of head trauma, imaging or exam findings)",
        "keywords": [
          "traumatic brain injury",
          "TBI",
          "head injury",
          "head trauma",
          "concussion",
          "subdural hematoma",
          "intracranial hemorrhage",
          "diffuse axonal injury"
        ]
      },
      {
        "logic": "OR",
        "path": "ALTERNATIVES",
        "criterion": "Any one paragraph (A/B/C/D as applicable)",
        "children": [
          {
            "path": "A",
            "criterion": "Disorganization of motor function in two extremities (see 11.00D1), resulting in an extreme limitation (see 11.00D2) in the ability to stand up from a seated position, balance while standing or walking, or use the upper extremities, persisting for at least 3 consecutive months after the injury",
            "keywords": [
              "motor weakness",
              "two extremity weakness",
              "extreme limitation",
              "stand from seated",
              "balance walking",
              "upper extremity use",
              "3 months post-injury",
              "persisting after injury"
            ],
            "duration_months_required": 3,
            "duration_basis": "post_injury_persistence"
          },
          {
            "logic": "AND",
            "path": "B",
            "criterion": "Marked limitation (see 11.00G2) in physical functioning (see 11.00G3a), AND in one of four mental functioning areas, persisting for at least 3 consecutive months after the injury",
            "children": [
              {
                "path": "B.1",
                "criterion": "Marked limitation in physical functioning (see 11.00G3a)",
                "keywords": [
                  "marked physical limitation"
                ]
              },
              {
                "logic": "OR",
                "path": "B.2",
                "criterion": "Marked limitation in ONE of four mental functioning areas",
                "children": [
                  {
                    "path": "B.2.a",
                    "criterion": "Marked limitation in understanding, remembering, or applying information (see 11.00G3b(i))",
                    "keywords": [
                      "understanding",
                      "remembering",
                      "applying information",
                      "cognitive deficit"
                    ]
                  },
                  {
                    "path": "B.2.b",
                    "criterion": "Marked limitation in interacting with others (see 11.00G3b(ii))",
                    "keywords": [
                      "social interaction",
                      "interacting",
                      "social limitation"
                    ]
                  },
                  {
                    "path": "B.2.c",
                    "criterion": "Marked limitation in concentrating, persisting, or maintaining pace (see 11.00G3b(iii))",
                    "keywords": [
                      "concentration",
                      "persistence",
                      "pace",
                      "attention"
                    ]
                  },
                  {
                    "path": "B.2.d",
                    "criterion": "Marked limitation in adapting or managing oneself (see 11.00G3b(iv))",
                    "keywords": [
                      "adapting",
                      "managing oneself",
                      "self-management"
                    ]
                  }
                ]
              }
            ],
            "duration_months_required": 3,
            "duration_basis": "post_injury_persistence"
          }
        ]
      }
    ]
  }
}