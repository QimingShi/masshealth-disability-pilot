{
  "code": "11.05",
  "title": "Benign brain tumors",
  "body_system": "neurological",
  "version": 2,
  "summary": "Benign brain tumor with disorganization of motor function in two extremities, OR marked limitation in physical functioning AND in one mental functioning area.",
  "synonyms": {
    "benign brain tumor":      ["brain tumor", "intracranial mass", "intracranial neoplasm", "meningioma", "pituitary adenoma", "schwannoma", "acoustic neuroma", "vestibular schwannoma"],
    "MRI brain":               ["MRI of brain", "brain MRI", "MRI with contrast"],
    "CT head":                 ["head CT", "CT scan of head"],
    "hemiparesis":             ["hemiplegia", "weakness on one side"],
    "ataxia":                  ["incoordination", "unsteady gait", "cerebellar signs"],
    "marked limitation":       ["marked", "moderately severe"],
    "extreme limitation":      ["extreme", "severe limitation"]
  },
  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "path": "PRECONDITION",
        "criterion": "Documented benign (non-malignant) brain tumor by imaging, biopsy, or operative report",
        "keywords": ["meningioma", "benign brain tumor", "pituitary adenoma", "vestibular schwannoma", "MRI brain", "biopsy", "operative pathology"]
      },
      {
        "logic": "OR",
        "path": "ALTERNATIVES",
        "criterion": "Disorganization of motor function in two extremities OR marked limitation pattern",
        "children": [
          {
            "path": "A",
            "criterion": "Disorganization of motor function in two extremities resulting in extreme limitation in standing, balancing, or use of upper extremities",
            "keywords": ["motor weakness", "hemiparesis", "ataxia", "cerebellar", "extreme limitation", "loss of balance"]
          },
          {
            "logic": "AND",
            "path": "B",
            "criterion": "Marked limitation (see 11.00G2) in physical functioning (see 11.00G3a), AND in one of four mental functioning areas",
            "children": [
              {
                "path": "B.1",
                "criterion": "Marked limitation in physical functioning (see 11.00G3a)",
                "keywords": ["marked physical limitation", "decreased mobility"]
              },
              {
                "logic": "OR",
                "path": "B.2",
                "criterion": "Marked limitation in ONE of four mental functioning areas",
                "children": [
                  {"path": "B.2.a", "criterion": "Marked limitation in understanding, remembering, or applying information (see 11.00G3b(i))",
                   "keywords": ["understanding", "remembering", "applying information", "cognitive deficit", "memory deficit"]},
                  {"path": "B.2.b", "criterion": "Marked limitation in interacting with others (see 11.00G3b(ii))",
                   "keywords": ["social interaction", "interacting", "social limitation", "personality change"]},
                  {"path": "B.2.c", "criterion": "Marked limitation in concentrating, persisting, or maintaining pace (see 11.00G3b(iii))",
                   "keywords": ["concentration", "persistence", "pace", "attention", "executive dysfunction"]},
                  {"path": "B.2.d", "criterion": "Marked limitation in adapting or managing oneself (see 11.00G3b(iv))",
                   "keywords": ["adapting", "managing oneself", "self-management"]}
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
