{
  "code": "11.12",
  "title": "Myasthenia gravis",
  "body_system": "neurological",
  "version": 2,
  "summary": "Myasthenia gravis (any of A/B/C) despite adherence to prescribed treatment for at least 3 months (see 11.00C): A) disorganization of motor function in two extremities, B) bulbar/neuromuscular dysfunction (myasthenic crisis or supplemental nutrition), or C) marked limitation in physical functioning AND in one of four mental functioning areas.",
  "synonyms": {
