  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "path": "PRECONDITION",
        "criterion": "Myasthenia gravis diagnosis (positive anti-AChR or anti-MuSK antibodies, abnormal EMG with decremental response, or edrophonium test) AND adherence to prescribed treatment for at least 3 months (see 11.00C)",
        "keywords": [
          "myasthenia gravis",
          "anti-AChR",
          "anti-MuSK",
          "decremental response",
          "edrophonium",
          "Tensilon",
          "3 months treatment",
          "treatment adherence"
        ],
        "duration_months_required": 3
      },
      {
        "logic": "OR",
        "path": "ALTERNATIVES",
        "criterion": "Any one paragraph (A/B/C/D as applicable)",
        "children": [
          {
            "path": "A",
            "criterion": "Disorganization of motor function in two extremities (see 11.00D1), resulting in an extreme limitation (see 11.00D2) in the ability to stand up from a seated position, balance while standing or walking, or use the upper extremities",
            "keywords": [
              "motor weakness",
              "two extremity weakness",
              "extreme limitation",
              "stand from seated",
              "balance walking",
              "upper extremity use"
            ]
          },
          {
            "logic": "OR",
            "path": "B",
            "criterion": "Bulbar and neuromuscular dysfunction (see 11.00F), resulting in mechanical ventilation OR supplemental nutrition",
            "children": [
              {
                "path": "B.1",
                "criterion": "One myasthenic crisis requiring mechanical ventilation",
                "keywords": [
                  "mechanical ventilation",
                  "respiratory failure",
                  "intubation",
                  "ventilator"
                ]
              },
              {
                "path": "B.2",
                "criterion": "Need for supplemental enteral nutrition via a gastrostomy or parenteral nutrition via a central venous catheter",
                "keywords": [
                  "gastrostomy",
                  "G-tube",
                  "PEG tube",
                  "enteral nutrition",
                  "parenteral nutrition",
                  "TPN",
                  "central venous catheter"
                ]
              }
            ]
          },
          {
            "logic": "AND",
            "path": "C",
            "criterion": "Marked limitation (see 11.00G2) in physical functioning (see 11.00G3a), AND in one of four mental functioning areas",
            "children": [
              {
                "path": "C.1",
                "criterion": "Marked limitation in physical functioning (see 11.00G3a)",
                "keywords": [
                  "marked physical limitation"
                ]
              },
              {
                "logic": "OR",
                "path": "C.2",
                "criterion": "Marked limitation in ONE of four mental functioning areas",
                "children": [
                  {
                    "path": "C.2.a",
                    "criterion": "Marked limitation in understanding, remembering, or applying information (see 11.00G3b(i))",
                    "keywords": [
                      "understanding",
                      "remembering",
                      "applying information",
                      "cognitive deficit"
                    ]
                  },
                  {
                    "path": "C.2.b",
                    "criterion": "Marked limitation in interacting with others (see 11.00G3b(ii))",
                    "keywords": [
                      "social interaction",
                      "interacting",
                      "social limitation"
                    ]
                  },
                  {
                    "path": "C.2.c",
                    "criterion": "Marked limitation in concentrating, persisting, or maintaining pace (see 11.00G3b(iii))",
                    "keywords": [
                      "concentration",
                      "persistence",
                      "pace",
                      "attention"
                    ]
                  },
                  {
                    "path": "C.2.d",
                    "criterion": "Marked limitation in adapting or managing oneself (see 11.00G3b(iv))",
                    "keywords": [
                      "adapting",
                      "managing oneself",
                      "self-management"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
