{
  "code": "11.11",
  "title": "Post-polio syndrome",
  "body_system": "neurological",
  "version": 2,
  "summary": "Post-polio syndrome with one of: A) disorganization of motor function in two extremities, B) unintelligible speech, C) bulbar/neuromuscular dysfunction requiring mechanical ventilation or supplemental nutrition, or D) marked limitation in physical functioning AND in one of four mental functioning areas.",
  "synonyms": {
    "post-polio syndrome": [
      "PPS",
      "late effects of polio",
      "poliomyelitis sequelae"
    ],
    "poliomyelitis": [
      "polio",
      "infantile paralysis"
    ],
    "bulbar dysfunction": [
      "dysphagia",
      "dysarthria",
      "swallowing difficulty"
    ],
    "respiratory weakness": [
      "respiratory muscle weakness",
      "diaphragm weakness",
      "ventilatory failure"
    ]
  },
  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "path": "PRECONDITION",
        "criterion": "Post-polio syndrome diagnosis (history of prior acute paralytic poliomyelitis)",
        "keywords": [
          "post-polio syndrome",
          "PPS",
          "prior poliomyelitis",
          "polio history"
        ]
      },
      {
        "logic": "OR",
        "path": "ALTERNATIVES",
        "criterion": "Any one paragraph (A/B/C/D as applicable)",
        "children": [
          {
            "path": "A",
            "criterion": "Disorganization of motor function in two extremities (see 11.00D1), resulting in an extreme limitation (see 11.00D2) in the ability to stand up from a seated position, balance while standing or walking, or use the upper extremities",
            "keywords": [
              "motor weakness",
              "two extremity weakness",
              "extreme limitation",
              "stand from seated",
              "balance walking",
              "upper extremity use"
            ]
          },
          {
            "path": "B",
            "criterion": "Unintelligible speech (see 11.00E3)",
            "keywords": [
              "unintelligible speech",
              "dysarthria",
              "speech unintelligible"
            ]
          },
          {
            "logic": "OR",
            "path": "C",
            "criterion": "Bulbar and neuromuscular dysfunction (see 11.00F), resulting in mechanical ventilation OR supplemental nutrition",
            "children": [
              {
                "path": "C.1",
                "criterion": "Acute respiratory failure requiring mechanical ventilation",
                "keywords": [
                  "mechanical ventilation",
                  "respiratory failure",
                  "intubation",
                  "ventilator"
                ]
              },
              {
                "path": "C.2",
                "criterion": "Need for supplemental enteral nutrition via a gastrostomy or parenteral nutrition via a central venous catheter",
                "keywords": [
                  "gastrostomy",
                  "G-tube",
                  "PEG tube",
                  "enteral nutrition",
                  "parenteral nutrition",
                  "TPN",
                  "central venous catheter"
                ]
              }
            ]
          },
          {
            "logic": "AND",
            "path": "D",
            "criterion": "Marked limitation (see 11.00G2) in physical functioning (see 11.00G3a), AND in one of four mental functioning areas",
            "children": [
              {
                "path": "D.1",
                "criterion": "Marked limitation in physical functioning (see 11.00G3a)",
                "keywords": [
                  "marked physical limitation"
                ]
              },
              {
                "logic": "OR",
                "path": "D.2",
                "criterion": "Marked limitation in ONE of four mental functioning areas",
                "children": [
                  {
                    "path": "D.2.a",
                    "criterion": "Marked limitation in understanding, remembering, or applying information (see 11.00G3b(i))",
                    "keywords": [
                      "understanding",
                      "remembering",
                      "applying information",
                      "cognitive deficit"
                    ]
                  },
                  {
                    "path": "D.2.b",
                    "criterion": "Marked limitation in interacting with others (see 11.00G3b(ii))",
                    "keywords": [
                      "social interaction",
                      "interacting",
                      "social limitation"
                    ]
                  },
                  {
                    "path": "D.2.c",
                    "criterion": "Marked limitation in concentrating, persisting, or maintaining pace (see 11.00G3b(iii))",
                    "keywords": [
                      "concentration",
                      "persistence",
                      "pace",
                      "attention"
                    ]
                  },
                  {
                    "path": "D.2.d",
                    "criterion": "Marked limitation in adapting or managing oneself (see 11.00G3b(iv))",
                    "keywords": [
                      "adapting",
                      "managing oneself",
                      "self-management"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}