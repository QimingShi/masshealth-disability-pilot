{
  "code": "12.13",
  "title": "Eating disorders",
  "body_system": "mental",
  "version": 1,
  "summary": "Eating disorder (anorexia nervosa, bulimia nervosa, binge-eating disorder, ARFID) with restriction or excessive eating, and paragraph B functional limitations.",
  "synonyms": {
    "anorexia nervosa":        ["anorexia", "AN", "restrictive eating"],
    "bulimia nervosa":         ["bulimia", "BN", "binge-purge"],
    "binge eating disorder":   ["BED", "binge eating"],
    "ARFID":                   ["avoidant/restrictive food intake disorder"],
    "low BMI":                 ["BMI low", "underweight", "wasting", "cachexia", "amenorrhea", "lanugo"],
    "purging":                 ["self-induced vomiting", "laxative abuse", "diuretic abuse", "compensatory behavior"],
    "binge eating":            ["binge episodes", "loss of control eating"],
    "marked limitation":       ["marked", "moderately severe"],
    "extreme limitation":      ["extreme", "severe limitation"]
  },
  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "logic": "OR",
        "path": "A",
        "criterion": "Medical documentation of persistent alterations in eating or eating-related behavior",
        "children": [
          {"path": "A.1", "criterion": "Persistent restriction of energy intake leading to significantly low body weight",
           "keywords": ["anorexia nervosa", "restriction", "low BMI", "underweight", "wasting", "amenorrhea"]},
          {"path": "A.2", "criterion": "Recurrent episodes of binge eating",
           "keywords": ["binge eating", "binge eating disorder", "BED", "loss of control eating"]},
          {"path": "A.3", "criterion": "Recurrent inappropriate compensatory behaviors to prevent weight gain",
           "keywords": ["purging", "self-induced vomiting", "laxative abuse", "compensatory behavior", "bulimia nervosa"]},
          {"path": "A.4", "criterion": "Significant disturbance in eating with avoidance/restriction not driven by body image",
           "keywords": ["ARFID", "avoidant restrictive food intake disorder", "food avoidance", "selective eating"]}
        ]
      },
      {
        "logic": "OR",
        "path": "B",
        "criterion": "Extreme limitation of one, OR marked limitation of two, of the four areas",
        "children": [
          {"path": "B.1", "criterion": "Marked/extreme limitation: understand, remember, apply information", "keywords": ["cognitive impairment"]},
          {"path": "B.2", "criterion": "Marked/extreme limitation: interact with others", "keywords": ["social isolation", "interpersonal difficulties"]},
          {"path": "B.3", "criterion": "Marked/extreme limitation: concentrate, persist, maintain pace", "keywords": ["concentration", "preoccupation with food"]},
          {"path": "B.4", "criterion": "Marked/extreme limitation: adapt, manage oneself", "keywords": ["self-management", "ADLs", "medical instability"]}
        ]
      }
    ]
  }
}
