{
  "code": "12.08",
  "title": "Personality and impulse-control disorders",
  "body_system": "mental",
  "version": 1,
  "summary": "Pervasive pattern of personality disorder (paranoid, schizoid, schizotypal, borderline, avoidant, dependent, OCPD) or intermittent explosive disorder, with paragraph B functional limitations.",
  "synonyms": {
    "personality disorder":    ["PD", "Cluster A", "Cluster B", "Cluster C"],
    "borderline":              ["borderline personality disorder", "BPD"],
    "schizoid":                ["schizoid personality"],
    "schizotypal":             ["schizotypal personality"],
    "paranoid":                ["paranoid personality"],
    "avoidant":                ["avoidant personality"],
    "dependent":               ["dependent personality"],
    "OCPD":                    ["obsessive-compulsive personality disorder"],
    "antisocial":              ["antisocial personality disorder", "ASPD", "sociopath"],
    "intermittent explosive disorder": ["IED", "explosive outbursts", "rage attacks"],
    "marked limitation":       ["marked", "moderately severe"],
    "extreme limitation":      ["extreme", "severe limitation"]
  },
  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "logic": "OR",
        "path": "A",
        "criterion": "Pervasive pattern of one or more of the following",
        "children": [
          {"path": "A.1", "criterion": "Distrust and suspiciousness of others (paranoid)",
           "keywords": ["paranoid personality", "distrust", "suspiciousness", "paranoia"]},
          {"path": "A.2", "criterion": "Detachment from social relationships (schizoid)",
           "keywords": ["schizoid personality", "social detachment", "social withdrawal"]},
          {"path": "A.3", "criterion": "Disregard for and violation of the rights of others (antisocial)",
           "keywords": ["antisocial personality disorder", "ASPD", "violates rights", "criminal behavior"]},
          {"path": "A.4", "criterion": "Instability of interpersonal relationships, self-image, and affects with marked impulsivity (borderline)",
           "keywords": ["borderline personality disorder", "BPD", "unstable relationships", "impulsivity", "self-harm", "fear of abandonment"]},
          {"path": "A.5", "criterion": "Excessive emotionality and attention seeking (histrionic)",
           "keywords": ["histrionic", "attention seeking", "emotional dysregulation"]},
          {"path": "A.6", "criterion": "Feelings of inadequacy (avoidant)",
           "keywords": ["avoidant personality", "social avoidance", "feelings of inadequacy"]},
          {"path": "A.7", "criterion": "Excessive need to be taken care of (dependent)",
           "keywords": ["dependent personality", "needs to be cared for", "submissive"]},
          {"path": "A.8", "criterion": "Preoccupation with orderliness, perfectionism, and control (obsessive-compulsive personality)",
           "keywords": ["OCPD", "obsessive-compulsive personality", "perfectionism", "rigid"]},
          {"path": "A.9", "criterion": "Recurrent, impulsive, aggressive behavioral outbursts (intermittent explosive)",
           "keywords": ["intermittent explosive disorder", "IED", "aggressive outbursts", "rage attacks"]}
        ]
      },
      {
        "logic": "OR",
        "path": "B",
        "criterion": "Extreme limitation of one, OR marked limitation of two, of the four areas",
        "children": [
          {"path": "B.1", "criterion": "Marked/extreme limitation: understand, remember, apply information", "keywords": ["memory", "cognitive"]},
          {"path": "B.2", "criterion": "Marked/extreme limitation: interact with others",
           "keywords": ["interpersonal difficulties", "social conflict", "unstable relationships"]},
          {"path": "B.3", "criterion": "Marked/extreme limitation: concentrate, persist, maintain pace", "keywords": ["concentration", "pace"]},
          {"path": "B.4", "criterion": "Marked/extreme limitation: adapt, manage oneself",
           "keywords": ["self-management", "emotional regulation", "self-harm"]}
        ]
      }
    ]
  }
}
