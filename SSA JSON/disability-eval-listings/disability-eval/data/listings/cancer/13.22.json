{
  "code": "13.22",
  "title": "Urinary bladder — carcinoma",
  "body_system": "cancer",
  "version": 1,
  "summary": "Bladder cancer with infiltration beyond bladder wall, recurrence after total cystectomy, inoperable/unresectable disease, OR metastases to or beyond regional lymph nodes.",
  "synonyms": {
    "bladder cancer":          ["urothelial carcinoma", "transitional cell carcinoma", "TCC", "urothelial carcinoma of bladder"],
    "muscle-invasive":         ["muscle-invasive bladder cancer", "MIBC", "T2 bladder cancer", "T3", "T4"],
    "cystectomy":              ["radical cystectomy", "total cystectomy", "bladder removal"],
    "metastasis":              ["distant metastases", "regional metastases", "M1 disease"],
    "biopsy":                  ["TURBT", "transurethral resection of bladder tumor", "cystoscopy with biopsy"]
  },
  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {"path": "PRECONDITION", "criterion": "Pathology-confirmed bladder cancer (carcinoma)",
       "keywords": ["bladder cancer", "urothelial carcinoma", "transitional cell carcinoma", "TCC", "biopsy", "TURBT", "cystoscopy"]},
      {
        "logic": "OR",
        "path": "ALTERNATIVES",
        "criterion": "Wall infiltration, recurrence, inoperable, or metastases",
        "children": [
