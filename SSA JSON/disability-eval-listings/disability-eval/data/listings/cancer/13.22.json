           "keywords": ["muscle-invasive", "T3 bladder cancer", "T4 bladder cancer", "tumor infiltration", "perivesical fat"]},
          {"path": "B", "criterion": "Recurrent disease following total cystectomy",
           "keywords": ["recurrent bladder cancer", "post-cystectomy recurrence", "treatment failure"]},
          {"path": "C", "criterion": "Inoperable or unresectable disease",
           "keywords": ["inoperable", "unresectable"]},
          {"path": "D", "criterion": "Metastases to or beyond regional lymph nodes",
           "keywords": ["regional lymph node metastases", "distant metastases", "M1 disease"]}
        ]
      }
    ]
  }
