  "rule_json": {
    "logic": "AND",
    "path": "ROOT",
    "children": [
      {
        "path": "PRECONDITION",
        "criterion": "Pathology-confirmed malignant melanoma (skin, ocular, or mucosal)",
        "keywords": [
          "pathology",
          "biopsy",
          "melanoma confirmed",
          "melanoma diagnosis",
          "histology"
        ]
      },
      {
        "logic": "OR",
        "path": "ALTERNATIVES",
        "criterion": "Meet one of A (recurrent), B (metastases), or C (mucosal)",
        "children": [
          {
            "logic": "OR",
            "path": "A",
            "criterion": "Recurrent melanoma following either 1 or 2 (excluding additional primary at different site)",
            "children": [
              {
                "path": "A.1",
                "criterion": "Recurrent skin melanoma following wide excision",
                "keywords": [
                  "recurrent melanoma",
                  "wide excision",
                  "WLE",
                  "skin melanoma recurrence",
                  "local recurrence"
                ]
              },
              {
                "path": "A.2",
                "criterion": "Recurrent ocular melanoma following enucleation of the eye",
                "keywords": [
                  "ocular melanoma",
                  "enucleation",
                  "uveal melanoma recurrence",
                  "ocular recurrence"
                ]
              }
            ]
          },
          {
            "logic": "OR",
            "path": "B",
            "criterion": "Metastases as described in 1, 2, or 3",
            "children": [
              {
                "path": "B.1",
                "criterion": "Metastases to one or more clinically apparent nodes (detected by imaging excluding lymphoscintigraphy, OR palpable)",
                "keywords": [
                  "clinically apparent nodes",
                  "palpable lymph node",
                  "imaging-detected nodes",
                  "regional lymph node mets"
                ]
              },
              {
                "path": "B.2",
                "criterion": "If nodes not clinically apparent, metastases to four or more nodes",
                "keywords": [
                  "sentinel lymph node biopsy",
                  "four or more nodes",
                  "4 nodes positive",
                  "occult nodal involvement"
                ]
              },
              {
                "path": "B.3",
                "criterion": "Metastases to adjacent skin (satellite lesions) or distant sites (liver, lung, brain, etc.)",
                "keywords": [
                  "satellite lesions",
                  "in-transit metastases",
                  "liver metastases",
                  "lung metastases",
                  "brain metastases",
                  "distant metastases",
                  "stage IV melanoma"
                ]
              }
            ]
          },
          {
            "path": "C",
            "criterion": "Mucosal melanoma (nasal, oral, anorectal, vulvovaginal, etc.) — disabled per se",
            "keywords": [
              "mucosal melanoma",
              "nasal melanoma",
              "oral melanoma",
              "anorectal melanoma",
              "sinonasal melanoma",
              "vulvovaginal melanoma"
            ]
          }
        ]
      }
    ]
  }
