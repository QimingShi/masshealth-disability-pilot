{
  "code": "13.15",
  "title": "Pleura or mediastinum cancer",
  "body_system": "cancer",
  "version": 2,
  "summary": "Pleura or mediastinum cancer meeting one of: A malignant mesothelioma of pleura, B tumors of the mediastinum (B.1 with metastases to or beyond regional lymph nodes, or B.2 persistent/recurrent following initial anticancer therapy), or C small-cell (oat cell) carcinoma.",
  "synonyms": {
    "mesothelioma":            ["malignant pleural mesothelioma", "MPM", "pleural mesothelioma", "asbestos-related cancer"],
    "thymoma":                 ["thymic carcinoma", "thymic cancer"],
    "small cell carcinoma":    ["oat cell carcinoma", "small-cell carcinoma", "SCLC"],
    "biopsy":                  ["pleural biopsy", "mediastinoscopy", "VATS biopsy"],
    "regional lymph nodes":    ["regional nodes", "mediastinal nodes", "hilar nodes"]
  },
  "rule_json": {
    "logic": "OR",
    "path": "ROOT",
    "children": [
      {
        "path": "A",
        "criterion": "Malignant mesothelioma of pleura",
        "keywords": ["mesothelioma", "malignant pleural mesothelioma", "pleural mesothelioma", "MPM", "asbestos"]
      },
      {
        "logic": "OR",
        "path": "B",
        "criterion": "Tumors of the mediastinum, as described in B.1 or B.2",
        "children": [
          {
            "path": "B.1",
            "criterion": "With metastases to or beyond the regional lymph nodes",
            "keywords": ["mediastinal cancer", "metastases beyond regional lymph nodes", "distant metastases", "nodal metastases"]
          },
          {
            "path": "B.2",
            "criterion": "Persistent or recurrent following initial anticancer therapy",
            "keywords": ["mediastinal cancer", "persistent disease", "recurrent disease", "recurrence", "treatment failure"]
          }
        ]
      },
      {
        "path": "C",
        "criterion": "Small-cell (oat cell) carcinoma",
        "keywords": ["small-cell carcinoma", "oat cell carcinoma", "SCLC", "small cell"]
      }
    ]
  }
}
